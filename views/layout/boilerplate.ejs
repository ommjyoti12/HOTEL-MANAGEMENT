<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wanderlust</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <!-- ✅ NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold fs-4" href="/listings">Wanderlust</a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">

          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/listings">
              All Listings
            </a>
          </li>

          <li class="nav-item ms-2">
            <a
              class="btn btn-danger text-white fw-semibold px-3"
              href="/listings/new"
            >
              + Add Listing
            </a>
          </li>

        </ul>
      </div>
    </div>
  </nav>

  <!-- ✅ PROFILE URL SECTION -->
  <div class="container mt-3">
    <div
      class="d-flex justify-content-between align-items-center
             bg-white shadow-sm rounded-3 px-4 py-3"
    >

      <div>
        <strong>My Profile:</strong>
        <a
          href="https://ommjyoti12.github.io/portfolio-websit/"
          target="_blank"
          class="text-decoration-none text-primary"
        >
          https://ommjyoti12.github.io/portfolio-websit/
        </a>
      </div>

      <div class="text-muted fw-semibold">
        Omm Jyoti Puthal Developer
      </div>

    </div>
  </div>

  <!-- ✅ PAGE CONTENT -->
  <div class="container mt-4">
    <%- body %>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
